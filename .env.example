# Rename this file to .env and fill in the values below.
# Jira Cloud / Confluence Cloud use the same Atlassian API token.
# Local models used by the agent. No data is sent to OpenAI.
# Install the model once: ollama pull embeddinggemma
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_CHAT_MODEL=qwen3.6:latest

ATLASSIAN_SITE=https://your-company.atlassian.net
ATLASSIAN_EMAIL=you@company.example
ATLASSIAN_API_TOKEN=

# Jira project key used while searching similar support requests.
JIRA_PROJECT=SUP
# Optional project key or full JQL filter for developer bug tasks. The full filter
# is combined with the ticket text when searching for related PROB tasks.
JIRA_PROB_PROJECT=PROB
# JIRA_PROB_JQL=project = "PROB" AND issuetype = Bug
# Optional: Confluence space key. Leave empty to search all accessible spaces.
CONFLUENCE_SPACE=

# Safety limits for the local HTTP service and external/local API calls.
MAX_REQUEST_BYTES=2097152
MAX_IMAGE_BYTES=1048576
MAX_TEXT_CHARS=12000
MAX_CONTEXT_CHARS=18000
HTTP_TIMEOUT_MS=30000
